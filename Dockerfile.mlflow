FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# mlflow[s3] pulls in boto3 + s3fs, needed for S3 backend store and artifact root
RUN pip install --no-cache-dir "mlflow[s3]"

EXPOSE 5000

ENTRYPOINT ["mlflow", "ui", "--host", "0.0.0.0", "--port", "5000"]
